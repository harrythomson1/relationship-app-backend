# Backend environment variables.
# Copy to .env (and/or .env.local for local dev, .env.test for tests) and fill in.
# In production (Railway) set these as service environment variables — never commit real secrets.

# --- Required (app refuses to start without these) ---
# Async SQLAlchemy URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/relationship_dev
# Supabase JWKS endpoint used to verify access tokens.
JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Supabase project URL.
PROJECT_URL=https://<project-ref>.supabase.co
# Expected JWT audience (usually "authenticated").
AUDIENCE=authenticated
# JWT signing algorithm (Supabase uses ES256).
ALGORITHM=ES256
# Resend API key for sending invite emails.
RESEND_API_KEY=re_xxx
# Supabase service-role key (admin operations such as account deletion).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Public base URL used to build invite-accept links in emails.
# Must point at this backend's production host.
INVITE_ACCEPT_BASE_URL=https://relationship-app-backend-production.up.railway.app

# --- Email ---
# "From" address for invite emails (must be on a Resend-verified domain for deliverability).
APP_EMAIL=no-reply@yourdomain.app

# --- Migrations / tests ---
# Sync SQLAlchemy URL (psycopg driver) used by Alembic and the test harness.
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/relationship_dev

# --- CORS ---
# Comma-separated allowed origins. Leave empty to disable CORS middleware. Never use "*".
CORS_ORIGINS=

# --- Error tracking (optional; disabled when unset) ---
SENTRY_DSN=
# Logical environment tag for Sentry events (e.g. production, staging).
SENTRY_ENVIRONMENT=production

# --- Background overlap notifier ---
OVERLAP_NOTIFIER_ENABLED=true
OVERLAP_NOTIFIER_INTERVAL_SECONDS=60

# --- Debug / diagnostics (keep off in production) ---
# Set to "true" only when debugging an endpoint locally; never enable in production.
ENABLE_TEST_PUSH_ENDPOINT=false
# Logs every SQL statement when "true" — dev only.
SQL_ECHO=false

# --- Connection pool (defaults shown) ---
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300

# --- Server ---
PORT=8080
